{
  "name": "pyte-web",
  "version": "0.2.0-alpha.9",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run assets",
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node server/index.mjs --dev",
    "assets": "node scripts/assets.mjs",
    "build": "npm run assets && tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "package": "npm run build && node scripts/package-windows.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "fflate": "^0.8.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
